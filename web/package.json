{
  "name": "voxwreck-web",
  "version": "1.0.0",
  "description": "Teardown-style voxel destruction sandbox (three.js)",
  "main": "index.js",
  "scripts": {
    "vendor": "mkdir -p public/vendor && cp node_modules/three/build/three.module.js node_modules/three/build/three.core.js public/vendor/ && cp -r node_modules/three/examples/jsm public/vendor/jsm",
    "postinstall": "npm run vendor",
    "serve": "http-server public -p 8899 --silent -c-1",
    "test": "node tests/all.mjs",
    "shot": "node tools/shot.mjs",
    "rmse": "node tools/rmse.mjs",
    "smoke": "node tools/smoke.mjs",
    "pack": "node tools/pack.mjs",
    "verify:pack": "node tools/verify_pack.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "three": "^0.185.1"
  },
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "http-server": "^14.1.1",
    "playwright": "^1.49.0"
  }
}
